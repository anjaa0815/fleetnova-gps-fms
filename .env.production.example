# Copy to .env.production and fill in. Never commit .env.production.

# --- required ---------------------------------------------------------------------------
DOMAIN=fleet.example.com                  # the address people open (DNS A record -> this server's IP)
APP_BASE_URL=https://fleet.example.com    # used in links inside e-mails
JWT_SECRET=                               # long random text: openssl rand -hex 48
ADMIN_EMAIL=you@example.com               # creates the platform owner (super admin) on the first start
ADMIN_PASSWORD=                           # at least 8 characters

# --- e-mail (sign-up confirmation, password reset, alerts). Without SMTP_HOST e-mails only go to the log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                         # true for port 465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=CLIXGPS <no-reply@fleet.example.com>

# --- SMS (optional): twilio | http. Without it SMS only go to the log ---
SMS_PROVIDER=
# twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# http (your own gateway receives {to, text, from} as JSON):
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_FROM=CLIXGPS

# --- plan payments with QPay (Billing page). Without these, online payment is off in production ---
QPAY_BASE_URL=https://merchant.qpay.mn/v2   # sandbox: https://merchant-sandbox.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
PLAN_PRICE_BASIC=49000                      # MNT per month (placeholder prices, set your own)
PLAN_PRICE_PRO=199000

# --- optional ---------------------------------------------------------------------------
ALERT_TIME_ZONE=Asia/Ulaanbaatar
GEMINI_API_KEY=                           # FleetAI assistant; empty = assistant disabled
